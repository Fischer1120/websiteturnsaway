---
type Row = {
  label: string;
  value?: string | number;
};

type Props = {
  title: string;
  rows: Row[];
};

const { title, rows } = Astro.props;
---

<aside class="sidecar">
  <h2>{title}</h2>
  <dl class="meta-list">
    {rows.filter((row) => row.value !== undefined && row.value !== "").map((row) => (
      <div class="meta-row">
        <dt class="meta-label">{row.label}</dt>
        <dd class="meta-value">{row.value}</dd>
      </div>
    ))}
  </dl>
</aside>
