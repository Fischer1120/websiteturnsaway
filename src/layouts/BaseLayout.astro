---
type SiteSection = "home" | "articles" | "images" | "admin";

type Props = {
  title?: string;
  description?: string;
  currentSection?: SiteSection;
};

const pathname = Astro.url.pathname;
const inferredSection: SiteSection = pathname.startsWith("/articles")
  ? "articles"
  : pathname.startsWith("/images")
    ? "images"
    : pathname.startsWith("/admin")
      ? "admin"
      : "home";
const {
  title = "Website Turns Away — Orbital Archive v2",
  description = "Orbital Archive v2：文章、图片、文件夹与元数据构成的个人档案站。",
  currentSection = inferredSection,
} = Astro.props;

const navItems: Array<{ id: SiteSection; href: string; label: string }> = [
  { id: "home", href: "/", label: "首页" },
  { id: "articles", href: "/articles", label: "文章" },
  { id: "images", href: "/images", label: "图片" },
  { id: "admin", href: "/admin", label: "管理入口" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#080A0D" />
    <title>{title}</title>
    <script is:inline src="/assets/theme.js"></script>
    <link rel="stylesheet" href="/assets/site.css" />
    <script is:inline src="/assets/site-ui.js" defer></script>
  </head>
  <body data-site-section={currentSection}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div class="site-frame">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Website Turns Away 首页">
          <span class="brand-mark" aria-hidden="true"><span></span></span>
          <span class="brand-copy">
            <strong>Website Turns Away</strong>
            <small>Orbital Archive v2</small>
          </span>
        </a>
        <div class="header-actions">
        <nav class="primary-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a class="nav-link" href={item.href} aria-current={item.id === currentSection ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <label class="theme-picker" data-theme-control hidden>
  <span class="visually-hidden">外观模式</span>
  <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
  <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
  <select data-theme-preference aria-label="外观模式"><option value="system">跟随系统</option><option value="light">白天模式</option><option value="dark">黑夜模式</option></select>
</label>
        </div>
      </header>
      <slot />
      <footer class="footer">
        <span class="system-text">ORBITAL ARCHIVE v2</span>
        <span>Static fallback + Cloudflare Pages Functions + R2</span>
      </footer>
    </div>
  </body>
</html>
