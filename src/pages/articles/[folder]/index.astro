---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RouteMatrix from "@/components/RouteMatrix.astro";
import PublicContentShell from "@/components/PublicContentShell.astro";
import { getArticleFolders } from "@/lib/content";

export function getStaticPaths() {
  return getArticleFolders().map((folder) => ({
    params: { folder: folder.slug },
    props: { folder },
  }));
}

const { folder } = Astro.props;
---

<BaseLayout title={`${folder.label} — 文章文件夹`} description={folder.description} currentSection="articles">
  <div class="layout-grid">
    <RouteMatrix
      section="articles"
      breadcrumbs={[{ label: "首页", href: "/" }, { label: "文章", href: "/articles" }, { label: folder.label }]}
    />
    <PublicContentShell
      kind="articles"
      eyebrow={`/articles/${folder.slug}`}
      title={folder.label}
      description={folder.description}
    />
  </div>
</BaseLayout>
