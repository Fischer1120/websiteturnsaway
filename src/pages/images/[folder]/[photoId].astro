---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RouteMatrix from "@/components/RouteMatrix.astro";
import PublicContentShell from "@/components/PublicContentShell.astro";
import { getPhotos } from "@/lib/content";

export function getStaticPaths() {
  return getPhotos().map((photo) => ({
    params: { folder: photo.folder, photoId: photo.id },
    props: { photo },
  }));
}

const { photo } = Astro.props;
---

<BaseLayout title={`${photo.title} — Website Turns Away`} description={photo.description} currentSection="images">
  <div class="layout-grid">
    <RouteMatrix
      section="images"
      breadcrumbs={[
        { label: "首页", href: "/" },
        { label: "图片", href: "/images" },
        { label: photo.folder, href: `/images/${photo.folder}` },
        { label: photo.title },
      ]}
    />
    <PublicContentShell
      kind="images"
      eyebrow={`Photo Record / ${photo.folder}/${photo.id}`}
      title={photo.title}
      description={photo.description}
    />
  </div>
</BaseLayout>
