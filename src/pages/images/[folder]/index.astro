---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RouteMatrix from "@/components/RouteMatrix.astro";
import PublicContentShell from "@/components/PublicContentShell.astro";
import { getPhotoFolders } from "@/lib/content";

export function getStaticPaths() {
  return getPhotoFolders().map((folder) => ({
    params: { folder: folder.slug },
    props: { folder },
  }));
}

const { folder } = Astro.props;
---

<BaseLayout title={`${folder.label} — 图片文件夹`} description={folder.description} currentSection="images">
  <div class="layout-grid">
    <RouteMatrix
      section="images"
      breadcrumbs={[{ label: "首页", href: "/" }, { label: "图片", href: "/images" }, { label: folder.label }]}
    />
    <PublicContentShell
      kind="images"
      eyebrow={`/images/${folder.slug}`}
      title={folder.label}
      description={folder.description}
    />
  </div>
</BaseLayout>
